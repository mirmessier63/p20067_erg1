Sign up

<%= form_with model: @user, url: registrations_url, class: "contents" do |form| %>

  <%= form.email_field :email_address, required: true, placeholder: "Enter you email", autofocus: true, value: params[:email_address]%>
  <br>

  <%= form.text_field :firstname, required: true, placeholder: "First Name", autofocus: true, value: params[:firstname]%>
  <br>

  <%= form.text_field :lastname, required: true, placeholder: "Last Name", autofocus: true, value: params[:lastname]%>
  <br>


  <%= form.password_field :password, required: true, placeholder: "Enter your password", maxlength: 72%>
  <br>


  <%= form.password_field :password_confirmation, required: true, placeholder: "Confirm your password",
                          maxlength: 72%>


  <br>

  <%= form.submit "Sign up"%>


<% end %>

